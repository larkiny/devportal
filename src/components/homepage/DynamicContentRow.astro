---
// DynamicContentRow — 2-column row with "Recently Updated" (curated) and
// "Bulletins" (dynamically queried from the docs collection).

import { getCollection } from 'astro:content';

const recentlyUpdated = [
  { label: 'AlgoKit Quick Start', href: '/getting-started/algokit-quick-start/' },
  { label: 'Smart Contract Overview', href: '/concepts/smart-contracts/overview/' },
  { label: 'AVM Overview', href: '/concepts/smart-contracts/avm/' },
  { label: 'AlgoKit CLI', href: '/algokit/cli/overview/' },
  { label: 'REST API Reference', href: '/reference/rest-api/' },
];

const allBulletins = await getCollection('docs', (entry) =>
  entry.id.startsWith('bulletins/')
);
const recentBulletins = allBulletins
  .sort((a, b) => b.id.localeCompare(a.id))
  .slice(0, 4);
---

<section class="w-full bg-white dark:bg-algo-navy">
  <div class="max-w-[--breakpoint-home-container] mx-auto px-5 md:px-9 py-10">
    <div class="border-t border-algo-lavender-300/30 dark:border-algo-teal-100/10 pt-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        {/* Left column: Recently Updated */}
        <div>
          <h3 class="font-bold text-base text-algo-lavender-400 dark:text-algo-teal-400 mb-3 !mt-0">
            Recently Updated
          </h3>
          <ul class="list-none !p-0 !m-0 space-y-2">
            {recentlyUpdated.map((link) => (
              <li class="!p-0 !m-0">
                <a
                  href={link.href}
                  class="text-sm text-algo-navy dark:text-white hover:text-algo-lavender-400 dark:hover:text-algo-teal-400 no-underline transition-colors duration-200"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

        {/* Right column: Bulletins */}
        <div>
          <h3 class="font-bold text-base text-algo-lavender-400 dark:text-algo-teal-400 mb-3 !mt-0">
            Bulletins
          </h3>
          {recentBulletins.length > 0 ? (
            <ul class="list-none !p-0 !m-0 space-y-2">
              {recentBulletins.map((entry) => (
                <li class="!p-0 !m-0">
                  <a
                    href={`/${entry.id}/`}
                    class="text-sm text-algo-navy dark:text-white hover:text-algo-lavender-400 dark:hover:text-algo-teal-400 no-underline transition-colors duration-200"
                  >
                    {entry.data.title}
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="text-sm text-gray-500 dark:text-gray-400">
              No bulletins at this time.
            </p>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
