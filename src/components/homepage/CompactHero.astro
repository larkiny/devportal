---
// CompactHero — slim headline + tagline hero for the homepage.
// The `.homepage-hero` class is required: CSS rules in components.css
// use it to set page/nav background colors and override header styling.
---

<section class="homepage-hero w-full bg-white dark:bg-algo-navy">
  <div
    class="max-w-[--breakpoint-home-container] mx-auto px-5 md:px-9 py-10 md:py-12"
  >
    <h1
      class="font-bold text-4xl md:text-5xl lg:text-6xl text-algo-navy dark:text-white !mt-0 !mb-2"
    >
      Algorand Developer Portal
    </h1>
    <p
      class="text-lg md:text-xl text-algo-lavender-400 dark:text-algo-teal-400 !mt-0 !mb-0"
    >
      Everything you need to build on Algorand.
    </p>
  </div>
</section>
